{
  "uid": "neuromesh-gpu",
  "title": "GPU (DCGM)",
  "description": "The RTX 5060 through dcgm-exporter (#22). Profiling fields such as SM_ACTIVE read N/A under WSL2, so their panels stay empty.",
  "tags": ["neuromesh", "gpu"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "Memory used", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "decmbytes" } },
      "targets": [{ "refId": "A", "expr": "DCGM_FI_DEV_FB_USED" }]
    },
    {
      "type": "stat", "title": "GPU utilisation", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } },
      "targets": [{ "refId": "A", "expr": "DCGM_FI_DEV_GPU_UTIL" }]
    },
    {
      "type": "stat", "title": "Power", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "watt" } },
      "targets": [{ "refId": "A", "expr": "DCGM_FI_DEV_POWER_USAGE" }]
    },
    {
      "type": "stat", "title": "Temperature", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "celsius", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 85 }] } } },
      "targets": [{ "refId": "A", "expr": "DCGM_FI_DEV_GPU_TEMP" }]
    },
    {
      "type": "timeseries", "title": "Frame buffer (MiB)", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "decmbytes" } },
      "targets": [
        { "refId": "A", "expr": "DCGM_FI_DEV_FB_USED", "legendFormat": "used" },
        { "refId": "B", "expr": "DCGM_FI_DEV_FB_FREE", "legendFormat": "free" }
      ]
    },
    {
      "type": "timeseries", "title": "GPU_UTIL against SM_ACTIVE", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "description": "GPU_UTIL is the share of time any kernel ran; SM_ACTIVE is the share of SMs busy. Under WSL2 SM_ACTIVE reads N/A.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        { "refId": "A", "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU_UTIL" },
        { "refId": "B", "expr": "DCGM_FI_PROF_SM_ACTIVE * 100", "legendFormat": "SM_ACTIVE" }
      ]
    },
    {
      "type": "timeseries", "title": "Power (W) and temperature (°C)", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "power W" },
        { "refId": "B", "expr": "DCGM_FI_DEV_GPU_TEMP", "legendFormat": "GPU °C" }
      ]
    },
    {
      "type": "timeseries", "title": "Clocks (MHz)", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "DCGM_FI_DEV_SM_CLOCK", "legendFormat": "SM" },
        { "refId": "B", "expr": "DCGM_FI_DEV_MEM_CLOCK", "legendFormat": "memory" }
      ]
    },
    {
      "type": "table", "title": "Every DCGM field and its last value", "gridPos": { "x": 0, "y": 20, "w": 24, "h": 12 },
      "description": "A field that never appears here is not supported on this card and driver; one that is always 0 may be either.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "last_over_time({__name__=~\"DCGM_FI_.*\"}[10m])", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "includeByName": { "__name__": true, "Value": true }, "renameByName": { "__name__": "field", "Value": "last value" } } }]
    }
  ]
}
