// go is the minimum language version the code needs; toolchain is the Go that
// builds it (buf v1.73.0 needs 1.26.7, and 1.26.8 carries the security fixes).
// Keeping them apart lets gopls load the workspace on an older installed Go.
go 1.26.3

toolchain go1.26.8

use (
	./packages/config
	./packages/logging
	./packages/middleware
	./packages/utils
	./sdk/go
	./services/gateway
	./services/runtime
	./test/integration
	./tools/certs
)
